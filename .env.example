APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_boilerplate?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
JWT_SECRET=change_me_to_long_random_secret
JWT_ISSUER=go-boilerplate
JWT_ACCESS_TOKEN_TTL=15m
DOCKER_DATABASE_URL=postgres://go_boilerplate_user:change_me@shared-postgres:5432/go_boilerplate?sslmode=disable
PROXY_NETWORK=proxy_network
PROXY_ALIAS=go-boilerplate-api
DB_NETWORK=db_network
